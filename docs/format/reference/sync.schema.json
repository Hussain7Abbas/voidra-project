{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^sync-[0-9a-hjkmnp-tv-z]{6}$"
    },
    "examinedRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "since": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "commits": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{40,64}$"
      }
    },
    "proposals": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^act-[0-9a-hjkmnp-tv-z]{6}$"
          },
          {
            "type": "string",
            "pattern": "^idea-[0-9a-hjkmnp-tv-z]{6}$"
          }
        ]
      }
    },
    "consumedRecords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "by": {
      "type": "string",
      "minLength": 1
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "id",
    "examinedRevision",
    "since",
    "commits",
    "proposals",
    "consumedRecords",
    "by",
    "at"
  ],
  "additionalProperties": {}
}
