{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^act-[0-9a-hjkmnp-tv-z]{6}$"
    },
    "type": {
      "type": "string",
      "enum": [
        "feature",
        "bug",
        "improvement",
        "docs",
        "profile-change",
        "research",
        "release"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "enum": [
        "discovery",
        "plan",
        "implement",
        "verify",
        "review",
        "done",
        "released",
        "cancelled"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "running",
        "waiting",
        "failed",
        "complete"
      ]
    },
    "doneBy": {
      "type": "string",
      "enum": [
        "agent",
        "you"
      ]
    },
    "assignee": {
      "type": "string",
      "minLength": 1
    },
    "parent": {
      "type": "string",
      "pattern": "^act-[0-9a-hjkmnp-tv-z]{6}$"
    },
    "blockedBy": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^act-[0-9a-hjkmnp-tv-z]{6}$"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "completedBySlices": {
      "type": "boolean"
    },
    "createdBy": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "profileChange": {
      "type": "object",
      "properties": {
        "block": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "answerId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "before": {
          "$ref": "#/$defs/__schema0"
        },
        "after": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "block",
        "answerId",
        "before",
        "after"
      ],
      "additionalProperties": {}
    },
    "planApproval": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "hashes": {
          "type": "object",
          "properties": {
            "requirements.md": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "blueprint.md": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "acceptance.md": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "requirements.md",
            "blueprint.md",
            "acceptance.md"
          ],
          "additionalProperties": {}
        }
      },
      "required": [
        "by",
        "at",
        "hashes"
      ],
      "additionalProperties": {}
    },
    "approvalHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "by": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "hashes": {
            "type": "object",
            "properties": {
              "requirements.md": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "blueprint.md": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "acceptance.md": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "requirements.md",
              "blueprint.md",
              "acceptance.md"
            ],
            "additionalProperties": {}
          }
        },
        "required": [
          "by",
          "at",
          "hashes"
        ],
        "additionalProperties": {}
      }
    },
    "reviewDecision": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "decision": {
          "type": "string",
          "enum": [
            "accepted",
            "rejected"
          ]
        },
        "feedback": {
          "type": "string"
        },
        "by": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "revision",
        "decision",
        "by",
        "at"
      ],
      "additionalProperties": {}
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "done": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "title",
          "done"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "id",
    "type",
    "title",
    "status",
    "doneBy"
  ],
  "additionalProperties": {},
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    },
    "__schema1": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema1"
          }
        }
      ]
    }
  }
}
