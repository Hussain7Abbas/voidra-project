{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^op-[0-9a-hjkmnp-tv-z]{6}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "prepared",
        "committed",
        "rolled-back"
      ]
    },
    "changes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "expectedHash": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "before": {
            "type": [
              "string",
              "null"
            ]
          },
          "after": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "path",
          "expectedHash",
          "before",
          "after"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "id",
    "fingerprint",
    "state",
    "changes"
  ],
  "additionalProperties": {}
}
