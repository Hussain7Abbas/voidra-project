{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^run-[0-9a-hjkmnp-tv-z]{6}$"
    },
    "action": {
      "type": "string",
      "pattern": "^act-[0-9a-hjkmnp-tv-z]{6}$"
    },
    "agent": {
      "type": "string",
      "enum": [
        "claude-code",
        "codex"
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "consumedRecords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "orderedIntent": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "queueRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "version",
        "revision",
        "queueRevision"
      ],
      "additionalProperties": {}
    },
    "endedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "fromStage": {
      "type": "string",
      "enum": [
        "discovery",
        "plan",
        "implement",
        "verify",
        "review",
        "done",
        "released",
        "cancelled"
      ]
    },
    "toStage": {
      "type": "string",
      "enum": [
        "discovery",
        "plan",
        "implement",
        "verify",
        "review",
        "done",
        "released",
        "cancelled"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "running",
        "advanced",
        "waiting",
        "failed",
        "interrupted"
      ]
    },
    "commit": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "passed"
        ],
        "additionalProperties": {}
      }
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "planningOnly": {
      "type": "boolean"
    },
    "quality": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "enum": [
            "pass",
            "rework",
            "questions"
          ]
        },
        "qa": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "checks": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "passed": {
                    "type": "boolean"
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "name",
                  "passed",
                  "evidence"
                ],
                "additionalProperties": {}
              }
            }
          },
          "required": [
            "summary",
            "checks"
          ],
          "additionalProperties": {}
        },
        "security": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "checks": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "passed": {
                    "type": "boolean"
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "name",
                  "passed",
                  "evidence"
                ],
                "additionalProperties": {}
              }
            }
          },
          "required": [
            "summary",
            "checks"
          ],
          "additionalProperties": {}
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "why": {
                "type": "string",
                "minLength": 1
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "recommended": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "label",
                    "description",
                    "recommended"
                  ],
                  "additionalProperties": {}
                }
              },
              "dependsOn": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^q-[0-9a-hjkmnp-tv-z]{6}$"
                }
              }
            },
            "required": [
              "text",
              "why",
              "options"
            ],
            "additionalProperties": {}
          }
        }
      },
      "required": [
        "summary",
        "decision",
        "qa",
        "security"
      ],
      "additionalProperties": {}
    },
    "sourceCommit": {
      "type": "string",
      "minLength": 1
    },
    "reviews": {
      "type": "object",
      "properties": {
        "standards": {
          "type": "object",
          "properties": {
            "passed": {
              "type": "boolean"
            },
            "summary": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "passed",
            "summary"
          ],
          "additionalProperties": {}
        },
        "plan": {
          "type": "object",
          "properties": {
            "passed": {
              "type": "boolean"
            },
            "summary": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "passed",
            "summary"
          ],
          "additionalProperties": {}
        }
      },
      "required": [
        "standards",
        "plan"
      ],
      "additionalProperties": {}
    }
  },
  "required": [
    "id",
    "action",
    "agent",
    "startedAt",
    "consumedRecords",
    "fromStage",
    "outcome"
  ],
  "additionalProperties": {}
}
