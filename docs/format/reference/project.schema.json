{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "requiredVoidra": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^prj-[0-9a-hjkmnp-tv-z]{6}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": {}
    },
    "template": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
            }
          },
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": {}
        },
        {
          "type": "null"
        }
      ]
    },
    "createdWith": {
      "type": "string",
      "minLength": 1
    },
    "releasePackage": {
      "type": "string",
      "maxLength": 4096
    },
    "taskTracking": {
      "type": "number",
      "const": 1
    },
    "taskWorkflow": {
      "type": "number",
      "const": 1
    },
    "lifecycleOverrides": {
      "$ref": "#/$defs/__schema0"
    }
  },
  "required": [
    "format",
    "requiredVoidra",
    "project",
    "template",
    "createdWith"
  ],
  "additionalProperties": {},
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
