{
  "name": "voidra-project",
  "version": "0.1.0",
  "private": true,
  "description": "Voidra Project desktop application",
  "type": "module",
  "main": "dist/main.cjs",
  "license": "AGPL-3.0-or-later",
  "author": "Hussain Abbas",
  "scripts": {
    "build": "next build --webpack && node scripts/build.ts",
    "dev": "pnpm build && electron .",
    "native": "electron-builder install-app-deps",
    "package:dir": "electron-builder --dir --mac --arm64",
    "e2e": "playwright test",
    "smoke:packaged": "node scripts/packaged-smoke.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "zod": "4.6.7",
    "voidra": "workspace:*"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3",
    "@playwright/test": "1.64.0",
    "@axe-core/playwright": "4.13.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "lucide-react": "1.55.0",
    "@tanstack/react-query": "5.104.2"
  },
  "build": {
    "appId": "dev.voidra.project",
    "productName": "Voidra Project",
    "asar": true,
    "asarUnpack": [
      "**/better-sqlite3/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "out/**",
      "package.json",
      "licenses/**",
      "LICENSE"
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null
    },
    "npmRebuild": true
  }
}
