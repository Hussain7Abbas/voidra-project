{
  "name": "voidra-project",
  "version": "1.1.1",
  "private": true,
  "description": "Voidra Project desktop application",
  "type": "module",
  "main": "dist/main.cjs",
  "license": "AGPL-3.0-or-later",
  "author": "Hussain Abbas",
  "scripts": {
    "build": "next build --webpack && node scripts/build.ts",
    "dev": "pnpm build && electron .",
    "native": "electron-builder install-app-deps",
    "package:dir": "electron-builder --dir --mac --arm64 --publish never",
    "e2e": "playwright test",
    "smoke:packaged": "node scripts/packaged-smoke.ts",
    "icon": "node scripts/icon.ts",
    "package:dmg": "electron-builder --mac dmg --arm64 --publish never"
  },
  "dependencies": {
    "@voidra/run-engine": "workspace:*",
    "better-sqlite3": "13.0.3",
    "chokidar": "5.0.0",
    "voidra": "workspace:*",
    "zod": "4.6.7",
    "@voidra/release-engine": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@fontsource-variable/inter": "5.3.0",
    "@lezer/markdown": "1.8.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query": "5.104.2",
    "@types/better-sqlite3": "9.6.0",
    "@types/hast": "3.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "lucide-react": "1.55.0",
    "micromark-util-decode-string": "2.0.1",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "unified": "11.0.5"
  },
  "build": {
    "publish": null,
    "appId": "dev.voidra.project",
    "productName": "Voidra Project",
    "asar": true,
    "asarUnpack": [
      "**/better-sqlite3/**",
      "dist/process-info"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "out/**",
      "package.json",
      "licenses/**",
      "LICENSE"
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "icon": "build/icon.icns"
    },
    "npmRebuild": true,
    "dmg": {
      "sign": false,
      "artifactName": "Voidra-Project-${version}-arm64.dmg"
    }
  }
}
